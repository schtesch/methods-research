@ARTICLE{Junger2017guidance,
  title    = "Guidance on Conducting and {REporting} {DElphi} Studies ({CREDES})
              in palliative care: Recommendations based on a methodological
              systematic review",
  author   = "Jünger, Saskia and Payne, Sheila A and Brine, Jenny and Radbruch,
              Lukas and Brearley, Sarah G",
  journal  = "Palliat. Med.",
  volume   =  31,
  number   =  8,
  pages    = "684--706",
  abstract = "BACKGROUND: The Delphi technique is widely used for the
              development of guidance in palliative care, having impact on
