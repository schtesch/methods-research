  language = "en"
}

@ARTICLE{Gartlehner2024rapid,
  title     = "Rapid reviews methods series: Guidance on assessing the certainty
               of evidence",
  author    = "Gartlehner, Gerald and Nussbaumer-Streit, Barbara and Devane,
