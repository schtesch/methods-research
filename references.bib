@ARTICLE{Owens2010ahrq,
  title    = "{AHRQ} series paper 5: grading the strength of a body of evidence
              when comparing medical interventions--agency for healthcare
              research and quality and the effective health-care program",
  author   = "Owens, Douglas K and Lohr, Kathleen N and Atkins, David and
