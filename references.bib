@ARTICLE{Heidari2016sex,
  title    = "Sex and Gender Equity in Research: rationale for the {SAGER}
              guidelines and recommended use",
  author   = "Heidari, Shirin and Babor, Thomas F and De Castro, Paola and Tort,
