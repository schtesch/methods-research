@ARTICLE{Power2024advisory,
  title     = "Advisory groups in realist reviews: Systematically mapping
               current research and recommendations for practice",
  author    = "Power, Jessica and Dada, Sara and Booth, Andrew and De Brún,
               Aoife and Gilmore, Brynne",
