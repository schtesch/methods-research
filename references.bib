@ARTICLE{Schreiber2017latent,
  title    = "Latent Class Analysis: An example for reporting results",
  author   = "Schreiber, James B",
  journal  = "Res. Social Adm. Pharm.",
  volume   =  13,
  number   =  6,
  pages    = "1196--1201",
  abstract = "OBJECTIVE: The purpose of this paper is to provide a brief
              non-mathematical introduction to Latent Class Analysis (LCA) and a
