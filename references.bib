@ARTICLE{Hlatky2009criteria,
  title    = "Criteria for evaluation of novel markers of cardiovascular risk: a
              scientific statement from the American Heart Association",
  author   = "Hlatky, Mark A and Greenland, Philip and Arnett, Donna K and
              Ballantyne, Christie M and Criqui, Michael H and Elkind, Mitchell
              S V and Go, Alan S and Harrell, Jr, Frank E and Hong, Yuling and
