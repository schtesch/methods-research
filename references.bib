@ARTICLE{Wang2022statistical,
  title     = "Statistical primer: an introduction to the application of linear
               mixed-effects models in cardiothoracic surgery outcomes
               research-a case study using homograft pulmonary valve replacement
               data",
  author    = "Wang, Xu and Andrinopoulou, Eleni-Rosalina and Veen, Kevin M and
