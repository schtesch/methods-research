@ARTICLE{Joshi2022solutions,
  title     = "Solutions to problems of nonexistence of parameter estimates and
               sparse data bias in Poisson regression",
  author    = "Joshi, Ashwini and Geroldinger, Angelika and Jiricka, Lena and
