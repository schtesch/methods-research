}

@ARTICLE{Kip2018toward,
  title    = "Toward Alignment in the Reporting of Economic Evaluations of
              Diagnostic Tests and Biomarkers: The {AGREEDT} Checklist",
  author   = "Kip, Michelle M A and IJzerman, Maarten J and Henriksson, Martin
              and Merlin, Tracy and Weinstein, Milton C and Phelps, Charles E
              and Kusters, Ron and Koffijberg, Hendrik",
