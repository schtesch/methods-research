  keywords  = "complete case; last observation carried forward; mean
               substitution; missing data; multiple imputation",
  doi       = "10.1093/ndt/gft221",
  pmid      =  23729490,
  issn      = "0931-0509,1460-2385",
  language  = "en"
}

