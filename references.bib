  pmc      = "PMC5606038",
  pmid     =  28927376,
  issn     = "1471-2288",
  language = "en"
}

@ARTICLE{Jakobsen2017when,
  title    = "When and how should multiple imputation be used for handling
              missing data in randomised clinical trials - a practical guide
