  year      =  2020,
  url       = "http://dx.doi.org/10.1097/JCP.0000000000001266",
  doi       = "10.1097/JCP.0000000000001266",
  pmid      =  32701908,
  issn      = "0271-0749,1533-712X",
  language  = "en"
