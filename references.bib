@ARTICLE{Leurent2018sensitivity,
  title    = "Sensitivity Analysis for Not-at-Random Missing Data in Trial-Based
              Cost-Effectiveness Analysis: A Tutorial",
  author   = "Leurent, Baptiste and Gomes, Manuel and Faria, Rita and Morris,
