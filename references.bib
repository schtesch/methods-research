}

@ARTICLE{Basu2020machine,
  title    = "Machine Learning Methods for Precision Medicine Research Designed
              to Reduce Health Disparities: A Structured Tutorial",
  author   = "Basu, Sanjay and Faghmous, James H and Doupe, Patrick",
