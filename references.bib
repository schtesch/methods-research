@ARTICLE{Jandoc2015interrupted,
  title    = "Interrupted time series analysis in drug utilization research is
              increasing: systematic review and recommendations",
  author   = "Jandoc, Racquel and Burden, Andrea M and Mamdani, Muhammad and
