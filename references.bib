@ARTICLE{deJong2020individual,
  title    = "Individual participant data meta-analysis of intervention studies
              with time-to-event outcomes: A review of the methodology and an
              applied example",
  author   = "de Jong, Valentijn M T and Moons, Karel G M and Riley, Richard D
              and Tudur Smith, Catrin and Marson, Anthony G and Eijkemans,
