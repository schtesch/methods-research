@ARTICLE{Kelly2016defining,
  title    = "{DEFINING} {RAPID} {REVIEWS}: A {MODIFIED} {DELPHI} {CONSENSUS}
              {APPROACH}",
  author   = "Kelly, Shannon E and Moher, David and Clifford, Tammy J",
