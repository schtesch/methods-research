  pmid      =  20358032,
  issn      = "1866-0452",
  language  = "en"
}

@ARTICLE{Ressing2010data,
  title     = "Data analysis of epidemiological studies: part 11 of a series on
               evaluation of scientific publications",
  author    = "Ressing, Meike and Blettner, Maria and Klug, Stefanie J",
  journal   = "Dtsch. Arztebl. Int.",
