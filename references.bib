@ARTICLE{Sadatsafavi2026bayesian,
  title     = "Bayesian sample size calculations for external validation studies
               of risk prediction models",
  author    = "Sadatsafavi, Mohsen and Gustafson, Paul and Setayeshgar, Solmaz
               and Wynants, Laure and D Riley, Richard",
  journal   = "Stat. Med.",
  publisher = "Wiley",
  volume    =  45,
  number    = "3-5",
  pages     = "e70389",
  abstract  = "Contemporary sample size calculations for external validation of
               risk prediction models require users to specify fixed values of
