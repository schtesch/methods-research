@ARTICLE{Tosh2011pragmatic,
  title    = "Pragmatic vs explanatory trials: the pragmascope tool to help
              measure differences in protocols of mental health randomized
              controlled trials",
  author   = "Tosh, Graeme and Soares-Weiser, Karla and Adams, Clive E",
  journal  = "Dialogues Clin. Neurosci.",
  volume   =  13,
  number   =  2,
  pages    = "209--215",
  abstract = "In the pragmatic-explanatory continuum, a randomized controlled
              trial (RCT) can at one extreme investigate whether a treatment
              could work in ideal circumstances (explanatory), or at the other
              extreme, whether it would work in everyday practice (pragmatic).
              How explanatory or pragmatic a study is can have implications for
              clinicians, policy makers, patients, researchers, funding bodies,
              and the public. There is an increasing need for studies to be open
              and pragmatic; however, explanatory trials are also needed. The
              previously developed Pragmatic-explanatory continuum indicator
              summary (PRECIS) was adapted into the Pragmascope tool to assist
