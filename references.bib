}

@ARTICLE{Currow2012refining,
  title    = "Refining a checklist for reporting patient populations and service
              characteristics in hospice and palliative care research",
  author   = "Currow, David C and Tieman, Jennifer J and Greene, Aine and Zafar,
              S Yousuf and Wheeler, Jane L and Abernethy, Amy P",
  journal  = "J. Pain Symptom Manage.",
  volume   =  43,
  number   =  5,
  pages    = "902--910",
  abstract = "CONTEXT: In specialist hospice and palliative care services,
              variations occur in diagnoses and prognoses of subpopulations
              referred, service configuration, and the health systems delivering
              care. These three levels of variation limit the ability to
              generalize study findings. OBJECTIVES: This article reports on
