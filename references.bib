@ARTICLE{Tennant2021-xe,
  title       = "Use of directed acyclic graphs ({DAGs}) to identify confounders
                 in applied health research: review and recommendations",
  author      = "Tennant, Peter W G and Murray, Eleanor J and Arnold, Kellyn F
                 and Berrie, Laurie and Fox, Matthew P and Gadd, Sarah C and
                 Harrison, Wendy J and Keeble, Claire and Ranker, Lynsie R and
                 Textor, Johannes and Tomova, Georgia D and Gilthorpe, Mark S
