  language  = "en"
}

@ARTICLE{Sauerbrei2009interpreting,
  title     = "Interpreting results in 2 x 2 tables: part 9 of a series on
               evaluation of scientific publications",
  author    = "Sauerbrei, Wilhelm and Blettner, Maria",
