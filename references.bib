@ARTICLE{Godolphin2023estimating,
  title    = "Estimating interactions and subgroup-specific treatment effects in
              meta-analysis without aggregation bias: A within-trial framework",
  author   = "Godolphin, Peter J and White, Ian R and Tierney, Jayne F and
