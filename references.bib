@ARTICLE{Bramhall2015quality,
  title    = "Quality of methods reporting in animal models of colitis",
  author   = "Bramhall, Michael and Flórez-Vargas, Oscar and Stevens, Robert and
              Brass, Andy and Cruickshank, Sheena",
