@ARTICLE{Buyukkaramikli2019tech-ver,
  title     = "{TECH}-{VER}: A verification checklist to reduce errors in models
               and improve their credibility",
  author    = "Büyükkaramikli, Nasuh C and Rutten-van Mölken, Maureen P M H and
