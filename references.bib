  affiliation = "Child Health Evaluative Sciences, Hospital for Sick Children,
                 ON, Toronto, Canada. Dalla Lana School of Public Health,
                 University of Toronto, ON, Toronto, Canada. Department of
                 Epidemiology \& Biostatistics, McGill University, Westmount,
