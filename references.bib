  language = "en"
}

@ARTICLE{Nedeltchev2010standardized,
  title    = "Standardized definitions and clinical endpoints in carotid artery
              and supra-aortic trunk revascularization trials",
  author   = "Nedeltchev, Krassen and Pattynama, Peter M and Biaminoo, Giancarlo
              and Diehm, Nicolas and Jaff, Michael R and Hopkins, L Nelson and
