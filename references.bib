  affiliation = "MRC Clinical Trials Unit at UCL, London, United Kingdom.
                 Nottingham Clinical Trials Unit, School of Medicine, University
                 of Nottingham, Nottingham, United Kingdom. Institute for
                 Evidence-Based Healthcare, Bond University, Queensland,
                 Australia. Women's College Research Institute, University of
                 Toronto, Toronto, Ontario, Canada. London School of Hygiene and
