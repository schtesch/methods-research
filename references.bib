@ARTICLE{Ferreira2023evaluating,
  title    = "Evaluating the quality of studies reporting on clinical
              applications of stromal vascular fraction: A systematic review and
              proposed reporting guidelines ({CLINIC}-{STRA}-{SVF})",
  author   = "Ferreira, Marcio Yuri and Carvalho Junior, José da Conceição and
