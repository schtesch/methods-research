  keywords = "I-squared; I2; heterogeneity; inconsistency; meta-analysis;
              prediction intervals",
  doi      = "10.1002/jrsm.1230",
  pmid     =  28058794,
  issn     = "1759-2887,1759-2879",
  language = "en"
}

