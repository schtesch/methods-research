}

@ARTICLE{Luo2016guidelines,
  title    = "Guidelines for Developing and Reporting Machine Learning
              Predictive Models in Biomedical Research: A Multidisciplinary View",
  author   = "Luo, Wei and Phung, Dinh and Tran, Truyen and Gupta, Sunil and
