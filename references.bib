@ARTICLE{Howard1997assessing,
  title     = "Assessing differences in clinical trials comparing surgical vs
               nonsurgical therapy: using common (statistical) sense",
  author    = "Howard, G and Chambless, L E and Kronmal, R A",
  journal   = "JAMA",
