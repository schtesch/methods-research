  language = "en"
}

@ARTICLE{Lund2021evidence-based-0001,
  title    = "Evidence-Based Research Series-Paper 3: Using an Evidence-Based
              Research approach to place your results into context after the
              study is performed to ensure usefulness of the conclusion",
  author   = "Lund, Hans and Juhl, Carsten B and Nørgaard, Birgitte and Draborg,
