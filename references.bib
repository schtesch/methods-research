@ARTICLE{Streiner2020statistics-0007,
  title     = "Statistics commentary series. Commentary no. 43: Patient
               preference trials: Patient preference trials",
  author    = "Streiner, David L",
  journal   = "J. Clin. Psychopharmacol.",
  publisher = "Ovid Technologies (Wolters Kluwer Health)",
  volume    =  40,
  number    =  6,
  pages     = "529--530",
  abstract  = "I n the previous commentary, we discussed minimization as an
               alternative to simple and stratified randomization. In this
               paper, we will discuss yet a different method of assigning people
               to groups, called patient preference trials (PPT), also known as
               preference clinical trials. The rationale behind PPTs is that
               ethical standards require full and informed consent from all
               participants in a clinical study. This means that they be told,
               among other things, that there will be (usually) 2 groups; 1
               consisting of a novel intervention and the other a placebo or
               treatment as usual (TAU). This would not be a problem if the
               participants do not care to which group they will be placed, but
               this is often not the case. For example, depressed patients
               prefer psychotherapy rather than medication; and people opt for
               larynx-saving radiation rather than total laryngectomy, although
               the latter results in a greater life expectancy. Consequently,
               some patients will be assigned to a new intervention, even if
               they prefer TAU, and vice versa. Again, this would not be an
               issue if it is possible to blind the interventions, but is a
               major problem if blinding is not possible. Thiswas the case in
               the At Home/Chez Soi project, in which homeless, mentally ill
               patients were assigned to TAU or an intervention that supplied
               them with subsidized housing. Obviously, the participants knew if
               they were or were not in the treatment group. Similarly, patient
               preferences come into play in most psychosocial and surgical
               trials where group assignment cannot be blinded. Because patients
               can often differentiate between an active drug and a placebo,
               this may also be a factor if the side-effects of drugs cannot be
               duplicated with active placebos. Patient preferences for 1 arm or
               the other in a trial exert an influence at 2, and possibly 3,
               stages of the research. First, patients may be reluctant to enter
               a study if they believe there is a chance they will not receive
               their preferred treatment. For example, a study comparing various
               treatments for prostate cancer was unable to recruit a sufficient
               number of patients because of their unwillingness to be blindly
               assigned to various conditions, preferring to make their own
               treatment decisions. Second, even if they accept randomization,
               mismatched patients are more likely to drop out of the trial
               early. The question is whether patient preferences affect the
               third stage of the study – the outcome. It has been hypothesized
               that those assigned to their preferred treatment may be more
               enthusiastic about participating and may exaggerate their gains;
               while the mismatched patients may suffer from “resentful
               demoralization,” and thus would do poorer than expected or simply
               not fill out the questionnaires. The evidence, though, is
               equivocal. Some studies with depressed patients have found that
               those assigned to their preferred treatment improved more than
               those not so assigned, while other studies have found no such
               relationship. Over the years, there have been a number of
               different research methods designed to account for patient
               preferences. These are outlined in some detail by Kowalski and
               Mrdjenovich, and can only be briefly summarized here. In the
               Brewin and Bradley design, patients are asked if they have a
               preference for treatment A or B. If they do, then that is what
               they receive. Those who express no preference are randomized as
               they would be in a traditional RCT. This procedure is modified
               slightly in the more commonly used comprehensive cohort design
               (CCD), in which patients are first asked if they are willing to
               be randomized. In the usual RCT design, those saying “no” would
               not be included in the study, whereas in the CCD, the refusers
               who are stillwilling to be in the study are next given the choice
               between treatments A and B; ie, they are assigned to their
               preferred group. Yet another variation is theWennberg design.
               Patients are randomized to either a randomization arm (in which
               case they are assigned to A or B, as in a traditional RCT), or an
               options arm, in which they can choose their treatment. In
               addition to accommodating patient preferences, all of these
               designs have the added advantage of including participants who
               would otherwise be excluded in a regular RCT. This increases not
               only the sample size, but also the external validity of the
               study; that is, the ability to generalize the results from the
               study participants to the population as a whole, because those
               who agree to participate in a study differ in many regards from
               those who refuse. All of these designs ultimately end up with 4
               groups: Randomized to A (RA), Randomized to B (RB), Opted for A
               (OA), and Opted for B (OB). The comparison of RA versus RB is
               identical to a",
  month     =  oct,
  year      =  2020,
  url       = "http://dx.doi.org/10.1097/JCP.0000000000001296",
  doi       = "10.1097/JCP.0000000000001296",
  pmid      =  33044357,
  issn      = "0271-0749,1533-712X",
  language  = "en"
}

@ARTICLE{Streiner2020statistics-0002,
  title     = "Statistics commentary series. Commentary no. 44: Internal and
               external validity: Internal and external validity",
  author    = "Streiner, David L",
  journal   = "J. Clin. Psychopharmacol.",
  publisher = "Ovid Technologies (Wolters Kluwer Health)",
  volume    =  40,
  number    =  6,
  pages     = "531--533",
  abstract  = "I n a previous commentary, 1 we discussed the difference between
               efficacy trials, which ask whether an intervention can work under
               ideal circumstances, and effectiveness trials, which seek to
               determine whether an intervention doeswork in the realworld. The
               article pointed out that many of the design features of 1 were
               opposite to the features of the other. For example, in efficacy
               trials, there are very strict criteria regarding who can be a
               participant, in order to increase the odds that the trial will
               show an effect; whereas in effectiveness trials, recruitment
               tries to replicate the characteristics of patients who will
               actually be seen by clinicians. In this paper, wewill discuss a
               related topic – the difference between the internal and external
               validity of a study. Internal and external validity were first
               discussed in a highly influential book (at least in psychology)
               by Donald Campbell and Julian Stanley called Experimental and
               Quasi-Experimental Designs for Research, which has subsequently
               gone through a number of revisions and name changes. Very
               briefly, internal validity is concerned with the believability of
               the results –was the study carried out and analyzed in such a way
               that you can trust the findings? That is, it deals with the
               procedures used in implementing the intervention and analyzing
               the data. On the other hand, external validity relates to the
               generalizability of the findings to other people, other settings,
               and other times. Neither internal nor external validity are
               yes/no concepts. Both exist along a continuum and are subjective
               assessments by the reader, based on his or her evaluation of the
               methods used in a study, although some unvalidated checklists do
               exist. Unlike the case with efficacy and effectiveness, there is
               not always a trade-off between the 2: increasing the internal
               validity of a study does not necessarily lead to a decrease in
               its external validity.",
  month     =  oct,
  year      =  2020,
  url       = "http://dx.doi.org/10.1097/JCP.0000000000001304",
  doi       = "10.1097/JCP.0000000000001304",
  pmid      =  33044353,
  issn      = "0271-0749,1533-712X",
  language  = "en"
}

@ARTICLE{Iwashyna2018choosing,
  title    = "Choosing outcomes for clinical trials: a pragmatic perspective",
  author   = "Iwashyna, Theodore J and McPeake, Joanne",
  journal  = "Curr. Opin. Crit. Care",
  volume   =  24,
  number   =  5,
  pages    = "428--433",
  abstract = "PURPOSE OF REVIEW: The turn to evidence-based medicine in critical
              care has lead to a dramatic increase in the number of randomized
              clinical trials. Yet many of these trials are not showing
              differences on an appropriately prespecified primary outcome. In
              light of this, there have been some heated arguments as to what
              sorts of clinical trials should be conducted. We synthesize
              pragmatic recommendations from two governing bases: rigorous
              statistical practice and a commitment to insuring trials provide
              information that should help guide patient-centered
              decision-making. RECENT FINDINGS: We suggest six principles for
              the selection of an randomized clinical trial primary outcome: (1)
              your intervention should plausibly change your primary outcome.
              (2) The primary outcome should be cared about by your audience.
              (3) The primary outcome should be relevant to patients. (4) The
              primary outcome should be measured efficiently. (5) The primary
              outcome should be measured reliably. (6) When possible, use a well
              understood continuous scale. In addition, principles for selecting
              secondary outcomes are described. SUMMARY: It may be of value,
              when proposing a trial, to present preliminary evidence
              documenting the extent to which a proposed primary outcome
              actually accords each of these principles.",
  month    =  oct,
  year     =  2018,
  url      = "http://dx.doi.org/10.1097/MCC.0000000000000532",
  doi      = "10.1097/MCC.0000000000000532",
  pmid     =  30074502,
  issn     = "1070-5295,1531-7072",
  language = "en"
}

@ARTICLE{Spicer2024subgroup,
