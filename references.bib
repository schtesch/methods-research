  keywords  = "reporting guidelines",
  doi       = "10.1001/jamanetworkopen.2023.17651",
  pmc       = "PMC10257091",
  pmid      =  37294569,
  issn      = "2574-3805",
  language  = "en"
}

@ARTICLE{Kahan2023consensus,
