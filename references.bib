@ARTICLE{Yu2017methods,
  title    = "Methods to perform systematic reviews of patient preferences: a
              literature survey",
  author   = "Yu, Tsung and Enkh-Amgalan, Nomin and Zorigt, Ganchimeg",
  journal  = "BMC Med. Res. Methodol.",
