@ARTICLE{Streiner2019statistics-0003,
  title     = "Statistics commentary series: Commentary no. 33: Degrees of
               freedom",
  author    = "Streiner, David L",
  journal   = "J. Clin. Psychopharmacol.",
  publisher = "Ovid Technologies (Wolters Kluwer Health)",
  volume    =  39,
  number    =  4,
  pages     = "295--296",
  abstract  = "O pen up almost any quantitative research report and you’ll see a
               multitude of statistical tests, most of which have degrees of
               freedom (df) associated with them. If you look at tables of
               significance for various statistical tests (if such things exist
               anymore, given that computers now produce those numbers for you),
               you’ll see that for a given value of a test, the significance
               level depends on the df. But what exactly are dfs, and what do
               they signify? Stay tuned, and all will be explained. But first, a
               soupçon of history. While working in the Guinness brewery in
               Ireland, William Gosset wrestled with the problem of how many
               samples are sufficient in order to assume that the distribution
               of scores could be modeled by the normal distribution. Publishing
               under the pseudonym of Student (since Guinness forbade their
               employees from publishing, for fear they will reveal trade
               secrets), he worked out the relationship between sample size and
               the distribution of scores, although he did not use the term df
               (although he lent his name to the t-test). That honor was
               reserved for Ronald Fisher, writing about the χ test. At the most
               basic level, df indicates the number of unique observations or
               data points that are free to vary. Starting with a very simple
               example, imagine that you have 2 numbers, X1 and X2, and you know
               that they sum to 10.X1 can take on any value: 3, 128, 4.27, −132,
               or whatever. Once it does, though, X2 is fixed: it has to equal
               10–X1. Similarly, X2 can assume any value, but once set, then the
               value of X1 is fixed at 10–X2. Thus, 2 numbers have 1 df; that
               is, only 1 value is free to vary. We can extend the example so
               that we have 3 values. Now, any 2 of them are free to vary but
               once they are determined, we have no choice about the third,
               because the 3 numbers have to sum to the total. In general, then,
               given that we have n numbers, there are n−1 dfs. Another way to
               think of df is that it is the number of observations minus the
               number of constraints, or parameters to be estimated (k). In the
               examples we just used, therewas 1 constraint – the sum, which is
               the parameter we’re estimating. Thus, df increases as n
               increases, and decreases with larger values of k. This
               alternative way of looking at df will come in handy when
               determining the dfs in more complicated situations, such as
               factorial analyses of variance (ANOVA). It also explains why,
               when calculating the standard deviation (SD), we divide by n if
               we’re calculating the population SD, and by n-1 when looking at a
               sample (which is far more common). The heart of the SD
               (forgetting all the square and square root terms) is howmuch each
               value differs from themean.We know themean of a population, in
               the very rare instances when we have a population, but need to
               estimate it for a sample. Hence, we lose 1 df and therefore must
               divide by n−1. Now let’s look at determining df for various
               univariate and bivariate tests. One-sample t-test. We use a
               1-sample t-test when we are comparing a sample to a known mean;
               for example, determining if the IQ in our sample differs from the
               population mean, which we know is 100, with σ (the symbol for a
               population SD) equal to 15. This is the same as the examples we
               just used, because there are n observations and k = 1, the sample
               mean. Hence, we use df = n−1. Two-sample t-test. This is the more
               common version of the t-test, used to compare the means of 2
               independent groups. Group 1 has n1 observations, Group 2 has n2,
               and k = 2, becausewe have to estimate the mean for each group.
               So, df = n1+n2−2. But, let’s complicate this a bit (and the rest
               of this paragraph can be safely ignored by thosewith no desire to
               become statistics mavens). If you run a t-test using one of the
               more common computer packages, you may see anywhere from 2 to 4
               different values of the t-test reported, some of which have
               fractional values for the df, such as 42.13. How can this be if
               we’re adding two integers and subtracting a third one? It can
               occur if the variances of the 2 groups are quite different. The
               t-test assumes that the variances are equal, and if they’re not,
               the test is not as powerful. Because the power of the t-test (and
               all statistical tests) depends on the df, the so-called
               Welch-Satterthwaite correction “shrinks” the df to reduce the
               power of the test, so that it ends up somewhere between n1+n2−2
               and the df of the smaller group; how much it shrinks depends on
               how much the variances differ. Now aren’t you sorry you asked?",
  month     =  jul,
  year      =  2019,
  url       = "http://dx.doi.org/10.1097/JCP.0000000000001060",
  doi       = "10.1097/jcp.0000000000001060",
  pmid      =  31149936,
  issn      = "0271-0749,1533-712X",
  language  = "en"
}

@ARTICLE{Hoffmann2021the,
  title    = "The multiplicity of analysis strategies jeopardizes replicability:
              lessons learned across disciplines",
  author   = "Hoffmann, Sabine and Schönbrodt, Felix and Elsas, Ralf and Wilson,
              Rory and Strasser, Ulrich and Boulesteix, Anne-Laure",
  journal  = "R. Soc. Open Sci.",
  volume   =  8,
  number   =  4,
  pages    =  201925,
  abstract = "For a given research question, there are usually a large variety
              of possible analysis strategies acceptable according to the
              scientific standards of the field, and there are concerns that
              this multiplicity of analysis strategies plays an important role
              in the non-replicability of research findings. Here, we define a
              general framework on common sources of uncertainty arising in
              computational analyses that lead to this multiplicity, and apply
              this framework within an overview of approaches proposed across
              disciplines to address the issue. Armed with this framework, and a
              set of recommendations derived therefrom, researchers will be able
              to recognize strategies applicable to their field and use them to
              generate findings more likely to be replicated in future studies,
              ultimately improving the credibility of the scientific process.",
  month    =  apr,
