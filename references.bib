  pmc      = "PMC4592386",
  pmid     =  26045102,
  issn     = "0277-6715,1097-0258",
  language = "en"
}

@ARTICLE{Johnson2015recommendations,
  title    = "Recommendations for choosing an analysis method that controls Type
              {I} error for unbalanced cluster sample designs with Gaussian
