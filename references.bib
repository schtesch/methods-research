  author      = "Kahan, Brennan C and Hall, Sophie S and Beller, Elaine M and
                 Birchenall, Megan and Chan, An-Wen and Elbourne, Diana and
                 Little, Paul and Fletcher, John and Golub, Robert M and Goulao,
                 Beatriz and Hopewell, Sally and Islam, Nazrul and Zwarenstein,
