@ARTICLE{duPrel2009critical,
  title     = "Critical appraisal of scientific articles: part 1 of a series on
               evaluation of scientific publications",
  author    = "du Prel, Jean-Baptist and Röhrig, Bernd and Blettner, Maria",
  journal   = "Dtsch. Arztebl. Int.",
