@ARTICLE{Sanchez-Meca2021improving,
  title    = "Improving the reporting quality of reliability generalization
              meta-analyses: The {REGEMA} checklist",
  author   = "Sánchez-Meca, Julio and Marín-Martínez, Fulgencio and López-López,
              José Antonio and Núñez-Núñez, Rosa Maria and Rubio-Aparicio, María
              and López-García, Juan José and López-Pina, José Antonio and
