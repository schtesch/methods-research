@ARTICLE{Butcher2022guidelines-0001,
  title    = "Guidelines for Reporting Outcomes in Trial Reports: The
              {CONSORT}-Outcomes 2022 Extension",
  author   = "Butcher, Nancy J and Monsour, Andrea and Mew, Emma J and Chan,
