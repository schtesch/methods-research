  pmid     =  28470760,
  issn     = "0277-6715,1097-0258",
  language = "en"
}

@ARTICLE{Austin2017intermediate,
  title    = "Intermediate and advanced topics in multilevel logistic regression
              analysis",
  author   = "Austin, Peter C and Merlo, Juan",
