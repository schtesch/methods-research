@ARTICLE{Schneider2009Other,
  title    = "``{ToxRTool}'', a new tool to assess the reliability of
              toxicological data",
  author   = "Schneider, Klaus and Schwarz, Markus and Burkholder, Iris and
              Kopp-Schneider, Annette and Edler, Lutz and Kinsner-Ovaskainen,
