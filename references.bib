  doi       = "10.1136/bmj-2024-081199",
  pmid      =  40132800,
  issn      = "1756-1833,0959-8138",
  language  = "en"
}

@ARTICLE{Chan2025spirit,
  title     = "{SPIRIT} 2025 statement: updated guideline for protocols of
               randomised trials",
  author    = "Chan, An-Wen and Boutron, Isabelle and Hopewell, Sally and Moher,
