}

@ARTICLE{FourieZirkelbach2022improving,
  title     = "Improving dose-optimization processes used in oncology drug
               development to minimize toxicity and maximize benefit to patients",
  author    = "Fourie Zirkelbach, Jeanne and Shah, Mirat and Vallejo, Jonathon
               and Cheng, Joyce and Ayyoub, Amal and Liu, Jiang and Hudson,
