@ARTICLE{ElSherif2024using,
  title     = "Using qualitative comparative analysis as a mixed methods
               synthesis in systematic mixed studies reviews: Guidance and a
               worked example",
  author    = "El Sherif, Reem and Pluye, Pierre and Hong, Quan Nha and Rihoux,
               Benoît",
  journal   = "Res. Synth. Methods",
  publisher = "Wiley",
  volume    =  15,
  number    =  3,
  pages     = "450--465",
  abstract  = "Qualitative comparative analysis (QCA) is a hybrid method
               designed to bridge the gap between qualitative and quantitative
               research in a case-sensitive approach that considers each case
               holistically as a complex configuration of conditions and
               outcomes. QCA allows for multiple conjunctural causation,
               implying that it is often a combination of conditions that
               produces an outcome, that multiple pathways may lead to the same
               outcome, and that in different contexts, the same condition may
               have a different impact on the outcome. This approach to
               complexity allows QCA to provide a practical understanding for
               complex, real-world situations, and the context of implementing
               interventions. There are guides for conducting QCA in primary
               research and quantitative systematic reviews yet, to our
               knowledge, no guidance for conducting QCA in systematic mixed
               studies reviews (SMSRs). Thus, the specific objectives of this
               paper are to (1) describe a step-by-step approach for novice
               researchers for using QCA to integrate qualitative and
               quantitative evidence, including guidance on how to use software;
               (2) highlight specific challenges; (3) propose potential
               solutions from a worked example; and (4) provide recommendations
               for reporting.",
  month     =  may,
  year      =  2024,
  url       = "https://onlinelibrary.wiley.com/doi/abs/10.1002/jrsm.1698",
  keywords  = "guidance; qualitative comparative analysis; systematic mixed
               studies reviews; worked example",
  doi       = "10.1002/jrsm.1698",
  pmid      =  38194944,
  issn      = "1759-2887,1759-2879",
  language  = "en"
}

@ARTICLE{Khalil2024automation,
